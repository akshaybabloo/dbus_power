<!DOCTYPE node PUBLIC "-//freedesktop//DTD D-BUS Object Introspection 1.0//EN"
        "http://www.freedesktop.org/standards/dbus/1.0/introspect.dtd">
<node name="/org/freedesktop/UPower/KbdBacklight">
  <interface name="org.freedesktop.UPower.KbdBacklight">
    <method name="GetMaxBrightness">
      <arg type="i" name="value" direction="out"/>
    </method>
    <method name="GetBrightness">
      <arg type="i" name="value" direction="out"/>
    </method>
    <method name="SetBrightness">
      <arg type="i" name="value" direction="in"/>
    </method>
    <signal name="BrightnessChanged">
      <arg type="i" name="value"/>
    </signal>
    <signal name="BrightnessChangedWithSource">
      <arg type="i" name="value"/>
      <arg type="s" name="source"/>
    </signal>
  </interface>
</node>
