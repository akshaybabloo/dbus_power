<!DOCTYPE node PUBLIC "-//freedesktop//DTD D-BUS Object Introspection 1.0//EN"
        "http://www.freedesktop.org/standards/dbus/1.0/introspect.dtd">
<!-- GDBus 2.80.0 -->
<node name="/org/gnome/SettingsDaemon/Power">
    <interface name="org.gnome.SettingsDaemon.Power.Keyboard">
        <method name="StepUp">
            <arg type="i" name="new_percentage" direction="out">
            </arg>
        </method>
        <method name="StepDown">
            <arg type="i" name="new_percentage" direction="out">
            </arg>
        </method>
        <method name="Toggle">
            <arg type="i" name="new_percentage" direction="out">
            </arg>
        </method>
        <signal name="BrightnessChanged">
            <arg type="i" name="brightness">
            </arg>
            <arg type="s" name="source">
            </arg>
        </signal>
        <property type="i" name="Brightness" access="readwrite">
        </property>
        <property type="i" name="Steps" access="read">
        </property>
    </interface>
    <interface name="org.gnome.SettingsDaemon.Power.Screen">
        <method name="StepUp">
            <arg type="i" name="new_percentage" direction="out">
            </arg>
            <arg type="s" name="connector" direction="out">
            </arg>
        </method>
        <method name="StepDown">
            <arg type="i" name="new_percentage" direction="out">
            </arg>
            <arg type="s" name="connector" direction="out">
            </arg>
        </method>
        <method name="Cycle">
            <arg type="i" name="new_percentage" direction="out">
            </arg>
            <arg type="i" name="output_id" direction="out">
            </arg>
        </method>
        <property type="i" name="Brightness" access="readwrite">
        </property>
    </interface>
</node>
